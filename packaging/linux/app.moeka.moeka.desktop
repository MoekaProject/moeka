[Desktop Entry]
Type=Application
Name=Moeka
GenericName=Markdown Editor
Comment=Local-first Markdown editor
Keywords=markdown;editor;text;notes;writing;
Exec=moeka %F
Icon=app.moeka.moeka
Terminal=false
Categories=Office;TextEditor;
MimeType=text/markdown;text/plain;
StartupNotify=true
StartupWMClass=app.moeka.moeka
Actions=LaunchX11;

[Desktop Action LaunchX11]
Name=Open with X11 system decorations
Exec=moeka-x11 %F
