<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>com.apple.security.app-sandbox</key>
        <true />
        <!-- Update checks are disabled in this channel; the network client is
             still needed for the WKWebView used by PDF/HTML export. -->
        <key>com.apple.security.network.client</key>
        <true />
        <!-- Folders the user picks in the open panel, plus the bookmarks that
             re-open them on the next launch. -->
        <key>com.apple.security.files.user-selected.read-write</key>
        <true />
        <key>com.apple.security.files.bookmarks.app-scope</key>
        <true />
    </dict>
</plist>
