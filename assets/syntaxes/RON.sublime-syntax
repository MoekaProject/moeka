%YAML 1.2
---
name: RON
file_extensions: [ron]
scope: source.ron
contexts:
  main:
    - match: '//.*$'
      scope: comment.line.double-slash.ron
    - match: '/\*'
      push: comment
    - match: 'r(#*)"'
      push:
        - meta_scope: string.quoted.double.raw.ron
        - match: '"\1'
          pop: true
    - match: '"'
      push:
        - meta_scope: string.quoted.double.ron
        - match: '\\(?:u\{[0-9a-fA-F_]+\}|x[0-9a-fA-F]{2}|.)'
          scope: constant.character.escape.ron
        - match: '"'
          pop: true
    - match: "'(?:\\\\(?:u\\{[0-9a-fA-F_]+\\}|x[0-9a-fA-F]{2}|.)|[^'\\\\])'"
      scope: string.quoted.single.ron
    - match: '#!?\['
      push:
        - meta_scope: meta.attribute.ron
        - match: '\]'
          pop: true
        - match: '\b(?:enable|implicit_some|unwrap_newtypes|unwrap_variant_newtypes|explicit_struct_names)\b'
          scope: entity.other.attribute-name.ron
        - include: main
    - match: '\b(?:true|false|None|Some|inf|NaN)\b'
      scope: constant.language.ron
    - match: '\b[A-Z][A-Za-z0-9_]*\b'
      scope: entity.name.type.ron
    - match: '\b[A-Za-z_][A-Za-z0-9_]*(?=\s*:)'
      scope: variable.other.member.ron
    - match: '(?<![A-Za-z_])[+-]?(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*(?:\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?)\b'
      scope: constant.numeric.ron
  comment:
    - meta_scope: comment.block.ron
    - match: '/\*'
      push: comment
    - match: '\*/'
      pop: true
