%YAML 1.2
---
name: D2
file_extensions: [d2]
scope: source.d2
contexts:
  main:
    - match: '#.*$'
      scope: comment.line.number-sign.d2
    - match: '"'
      push:
        - meta_scope: string.quoted.double.d2
        - match: '\\.'
          scope: constant.character.escape.d2
        - match: '"'
          pop: true
    - match: "'"
      push:
        - meta_scope: string.quoted.single.d2
        - match: "'"
          pop: true
    - match: '\|([A-Za-z0-9_]*)\s*$'
      push:
        - meta_scope: string.unquoted.block.d2
        - match: '^\s*\|\s*(?:#.*)?$'
          pop: true
    - match: '<->|->|<-|--'
      scope: keyword.operator.d2
    - match: '\b(?:direction|shape|style|label|icon|link|tooltip|width|height|near|top|left|grid-rows|grid-columns|grid-gap|vertical-gap|horizontal-gap|constraint|classes|class|vars|scenarios|steps|layers|source-arrowhead|target-arrowhead)\b(?=\s*[:.])'
      scope: support.type.property-name.d2
    - match: '\b(?:true|false|null)\b'
      scope: constant.language.d2
    - match: '(?<![A-Za-z_])-?[0-9]+(?:\.[0-9]+)?\b'
      scope: constant.numeric.d2
