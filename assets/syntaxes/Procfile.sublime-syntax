%YAML 1.2
---
name: Procfile
file_extensions: [Procfile, procfile]
scope: source.procfile
contexts:
  main:
    - match: '^\s*#.*$'
      scope: comment.line.number-sign.procfile
    - match: '^([A-Za-z0-9_-]+)(:)'
      captures:
        1: entity.name.function.process.procfile
        2: punctuation.separator.procfile
      push:
        - match: '$'
          pop: true
        - include: scope:source.shell.bash
