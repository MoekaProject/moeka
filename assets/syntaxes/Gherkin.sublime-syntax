%YAML 1.2
---
name: Gherkin
file_extensions: [feature]
scope: text.gherkin
contexts:
  main:
    - match: '^\s*#.*$'
      scope: comment.line.number-sign.gherkin
    - match: '^\s*(Feature|Rule|Background|Scenario Outline|Scenario Template|Scenario|Example|Examples|Scenarios|功能|规则|背景|场景大纲|场景|例子|Fonctionnalité|Contexte|Plan du scénario|Scénario|Exemples|Funktionalität|Grundlage|Szenariogrundriss|Szenario|Beispiele)\s*[:：]'
      scope: keyword.declaration.gherkin
    - match: '^\s*(?:Given|When|Then|And|But|Soit|Etant donné|Étant donné|Quand|Alors|Et|Mais|Angenommen|Wenn|Dann|Und|Aber)\b'
      scope: keyword.control.gherkin
    - match: '^\s*(?:假如|假设|假定|当|那么|而且|并且|同时|但是|但|如果)'
      scope: keyword.control.gherkin
    - match: '^\s*\*(?=\s)'
      scope: keyword.control.gherkin
    - match: '@[^\s@]+'
      scope: entity.name.tag.gherkin
    - match: '^\s*"""'
      push:
        - meta_scope: string.quoted.triple.gherkin
        - match: '^\s*"""'
          pop: true
    - match: '^\s*```'
      push:
        - meta_scope: string.quoted.triple.gherkin
        - match: '^\s*```'
          pop: true
    - match: '"'
      push:
        - meta_scope: string.quoted.double.gherkin
        - match: '\\.'
          scope: constant.character.escape.gherkin
        - match: '"'
          pop: true
    - match: '<[^<>\n]+>'
      scope: variable.parameter.gherkin
    - match: '\|'
      scope: punctuation.separator.table.gherkin
    - match: '\b[0-9]+(?:\.[0-9]+)?\b'
      scope: constant.numeric.gherkin
