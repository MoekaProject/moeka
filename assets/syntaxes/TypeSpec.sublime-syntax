%YAML 1.2
---
name: TypeSpec
file_extensions: [tsp]
scope: source.typespec
contexts:
  main:
    - match: '//.*$'
      scope: comment.line.double-slash.typespec
    - match: '/\*'
      push:
        - meta_scope: comment.block.typespec
        - match: '\*/'
          pop: true
    - match: '"""'
      push:
        - meta_scope: string.quoted.triple.typespec
        - match: '"""'
          pop: true
    - match: '"'
      push:
        - meta_scope: string.quoted.double.typespec
        - match: '\\.'
          scope: constant.character.escape.typespec
        - match: '"'
          pop: true
    - match: '`'
      push:
        - meta_scope: entity.name.quoted.typespec
        - match: '\\.'
          scope: constant.character.escape.typespec
        - match: '`'
          pop: true
    - match: '@@?[A-Za-z_$][A-Za-z0-9_.$]*'
      scope: entity.name.function.decorator.typespec
    - match: '#[A-Za-z_][A-Za-z0-9_]*'
      scope: keyword.control.directive.typespec
    - match: '\b(?:alias|const|dec|else|enum|extends|extern|fn|if|import|interface|is|model|namespace|op|projection|return|scalar|typeof|union|using|valueof)\b'
      scope: keyword.declaration.typespec
    - match: '\b(?:string|boolean|bytes|numeric|integer|float|int8|int16|int32|int64|uint8|uint16|uint32|uint64|safeint|float32|float64|decimal|decimal128|url|plainDate|plainTime|utcDateTime|offsetDateTime|duration|unknown|never|void)\b'
      scope: storage.type.typespec
    - match: '\b(?:true|false|null)\b'
      scope: constant.language.typespec
    - match: '\b[A-Z][A-Za-z0-9_]*\b'
      scope: entity.name.type.typespec
    - match: '(?<![A-Za-z_])-?(?:0[xX][0-9a-fA-F]+|0[bB][01]+|[0-9]+(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)\b'
      scope: constant.numeric.typespec
    - match: '\.\.\.|=>|[=|&?:+*/<>!-]'
      scope: keyword.operator.typespec
