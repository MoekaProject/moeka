%YAML 1.2
---
name: Thrift
file_extensions: [thrift]
scope: source.thrift
contexts:
  main:
    - match: '(?://|#).*$'
      scope: comment.line.thrift
    - match: '/\*'
      push:
        - meta_scope: comment.block.thrift
        - match: '\*/'
          pop: true
    - match: '"'
      push:
        - meta_scope: string.quoted.double.thrift
        - match: '\\.'
          scope: constant.character.escape.thrift
        - match: '"'
          pop: true
    - match: "'"
      push:
        - meta_scope: string.quoted.single.thrift
        - match: '\\.'
          scope: constant.character.escape.thrift
        - match: "'"
          pop: true
    - match: '\b(?:include|cpp_include|namespace|const|typedef|enum|senum|struct|union|exception|service|extends|oneway|throws|required|optional)\b'
      scope: keyword.declaration.thrift
    - match: '\b(?:bool|byte|i8|i16|i32|i64|double|string|binary|list|set|map|void)\b'
      scope: storage.type.thrift
    - match: '\b(?:true|false)\b'
      scope: constant.language.thrift
    - match: '(?<![A-Za-z_])[+-]?(?:0[xX][0-9a-fA-F]+|[0-9]+(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)\b'
      scope: constant.numeric.thrift
    - match: '\b[A-Z][A-Za-z0-9_]*\b'
      scope: entity.name.type.thrift
