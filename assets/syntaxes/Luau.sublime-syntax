%YAML 1.2
---
name: Luau
file_extensions: [luau]
scope: source.luau
contexts:
  main:
    - match: '--\[(=*)\['
      push:
        - meta_scope: comment.block.luau
        - match: '\]\1\]'
          pop: true
    - match: '--.*$'
      scope: comment.line.double-dash.luau
    - match: '\[(=*)\['
      push:
        - meta_scope: string.quoted.multiline.luau
        - match: '\]\1\]'
          pop: true
    - match: '"'
      push:
        - meta_scope: string.quoted.double.luau
        - match: '\\.'
          scope: constant.character.escape.luau
        - match: '"'
          pop: true
    - match: "'"
      push:
        - meta_scope: string.quoted.single.luau
        - match: '\\.'
          scope: constant.character.escape.luau
        - match: "'"
          pop: true
    - match: '\b(?:type|export|typeof|continue)\b'
      scope: keyword.declaration.luau
    - match: '\b(?:any|unknown|never|number|string|boolean|thread|buffer)\b'
      scope: storage.type.luau
    - match: '::|\+=|-=|\*=|/=|//=|%=|\^=|\.\.=|->|\?'
      scope: keyword.operator.luau
    - match: '`'
      push:
        - meta_scope: string.quoted.other.luau
        - match: '\\.'
          scope: constant.character.escape.luau
        - match: '\{'
          push: interpolation
        - match: '`'
          pop: true
    - match: '\b(?:and|break|do|else|elseif|end|for|function|if|in|local|not|or|repeat|return|then|until|while)\b'
      scope: keyword.control.luau
    - match: '\b(?:true|false|nil)\b'
      scope: constant.language.luau
    - match: '\b(?:assert|error|getmetatable|ipairs|next|pairs|pcall|print|rawequal|rawget|rawset|select|setmetatable|tonumber|tostring|type|unpack|xpcall|require)\b'
      scope: support.function.luau
    - match: '(?<![A-Za-z_])(?:0[xX][0-9a-fA-F_]+(?:\.[0-9a-fA-F_]*)?(?:[pP][+-]?[0-9_]+)?|0[bB][01_]+|[0-9][0-9_]*(?:\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?|\.[0-9_]+)\b'
      scope: constant.numeric.luau
    - match: '==|~=|<=|>=|//|\.\.\.?|[=+*/%^<>#:-]'
      scope: keyword.operator.luau
  interpolation:
    - clear_scopes: 1
    - meta_scope: meta.interpolation.luau
    - match: '\}'
      pop: true
    - match: '\{'
      push: interpolation
    - include: main
