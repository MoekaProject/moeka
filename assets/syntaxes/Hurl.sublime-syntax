%YAML 1.2
---
name: Hurl
file_extensions: [hurl]
scope: source.hurl
contexts:
  main:
    - match: '#.*$'
      scope: comment.line.number-sign.hurl
    - match: '^\s*(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS|CONNECT|TRACE)\b'
      scope: keyword.control.http-method.hurl
    - match: '^\s*HTTP(?:/[0-9.]+)?\s+'
      scope: keyword.control.http-status.hurl
    - match: '^\s*\[(?:QueryStringParams|FormParams|MultipartFormData|Cookies|BasicAuth|Captures|Asserts|Options)\]'
      scope: keyword.declaration.section.hurl
    - match: '```'
      push:
        - meta_scope: string.quoted.triple.hurl
        - match: '```'
          pop: true
        - include: template
    - match: '"'
      push:
        - meta_scope: string.quoted.double.hurl
        - match: '\\.'
          scope: constant.character.escape.hurl
        - match: '"'
          pop: true
        - include: template
    - include: template
    - match: 'https?://[^\s#{}]+'
      scope: string.unquoted.url.hurl
    - match: '^\s*[A-Za-z0-9_-]+(?=\s*:)'
      scope: entity.other.attribute-name.hurl
    - match: '\b(?:status|url|header|cookie|body|bytes|xpath|jsonpath|regex|variable|duration|sha256|md5|certificate|version|count|daysAfterNow|daysBeforeNow|nth|replace|split|toInt|toFloat|decode|htmlEscape|htmlUnescape|urlEncode|urlDecode|base64Encode|base64Decode|exists|contains|startsWith|endsWith|matches|isInteger|isFloat|isBoolean|isString|isCollection|include|not|file)\b'
      scope: support.function.hurl
    - match: '\b(?:true|false|null)\b'
      scope: constant.language.hurl
    - match: '(?<![A-Za-z_])-?[0-9]+(?:\.[0-9]+)?\b'
      scope: constant.numeric.hurl
    - match: '==|!=|<=|>=|[<>]'
      scope: keyword.operator.hurl
  template:
    - match: '\{\{'
      push:
        - meta_scope: variable.other.template.hurl
        - match: '\}\}'
          pop: true
