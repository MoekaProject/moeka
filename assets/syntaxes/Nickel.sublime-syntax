%YAML 1.2
---
name: Nickel
file_extensions: [ncl]
scope: source.nickel
contexts:
  main:
    - match: '#.*$'
      scope: comment.line.number-sign.nickel
    - match: '"'
      push:
        - meta_scope: string.quoted.double.nickel
        - match: '\\.'
          scope: constant.character.escape.nickel
        - match: '%\{'
          push: interpolation
        - match: '"'
          pop: true
    - match: '\b(?:let|rec|in|fun|if|then|else|match|import|default|force|optional|not_exported|doc|priority)\b'
      scope: keyword.control.nickel
    - match: '\b(?:Dyn|Number|Bool|String|Array|Dict|Null|ForeignId|Symbol)\b'
      scope: storage.type.nickel
    - match: '\b(?:true|false|null)\b'
      scope: constant.language.nickel
    - match: "'[A-Za-z_][A-Za-z0-9_]*"
      scope: constant.other.enum.nickel
    - match: '\bstd(?:\.[A-Za-z_][A-Za-z0-9_]*)+\b'
      scope: support.function.nickel
    - match: '(?<![A-Za-z_])-?[0-9]+(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\b'
      scope: constant.numeric.nickel
    - match: '=>|->|==|!=|&&|\|\||\+\+|[=+*/%<>!&|:-]+'
      scope: keyword.operator.nickel
  interpolation:
    - clear_scopes: 1
    - meta_scope: meta.interpolation.nickel
    - match: '\}'
      pop: true
    - match: '\{'
      push: interpolation
    - include: main
